<h1>Articles</h1>

<% if authenticated? %>
  <%= link_to "New Article", new_article_path %>
<% end %>

<% @articles.each do |article| %>

  <h3>
    <%= link_to article.title, article %>
  </h3>

  <p>
    By <%= article.user.email_address %>
  </p>

  <% if authenticated? &&
        article.user != Current.user %>

    <%= button_to "Report",
          report_article_path(article),
          method: :patch %>

  <% end %>

<% end %>