<h1>Products</h1>
<%= link_to "Login",
            new_session_path unless authenticated? %>

<%= link_to "New product",
            new_product_path if authenticated? %>

<% @products.each do |product| %>
  <div>
    <%= link_to product.name, product %>
    <%= link_to "Edit", edit_product_path(product) %>
    <%= button_to "Delete",
              product,
              method: :delete,
              data: { turbo_confirm: "Are you sure?" } %>
  </div>
<% end %>